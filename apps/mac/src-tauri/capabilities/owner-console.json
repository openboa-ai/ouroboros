{
  "identifier": "owner-console",
  "description": "Local owner window. Fixed Gateway commands only; no filesystem, shell or arbitrary HTTP plugin.",
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "allow-connect-profile",
    "allow-connect-saved-profile",
    "allow-catalog-publication",
    "allow-company-snapshot",
    "allow-inspect-service-continuation",
    "allow-stop-service-continuation",
    "allow-service-continuation-stop-request",
    "allow-company-command",
    "allow-command-receipt",
    "allow-ceo-message",
    "allow-ceo-messages",
    "allow-save-artifact",
    "allow-save-copy",
    "allow-inspect-record",
    "allow-deliver-message",
    "allow-catalog-workspaces",
    "allow-catalog-workspace",
    "allow-prepare-catalog-upload",
    "allow-catalog-upload",
    "allow-catalog-upload-content",
    "allow-catalog-publish",
    "allow-catalog-resource-receipt",
    "allow-read-artifact",
    "allow-notifications",
    "allow-read-notifications",
    "allow-prepare-company-package",
    "allow-mount-company-view",
    "allow-position-company-view",
    "allow-release-company-package",
    "allow-close-company-view",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ],
  "webviews": [
    "main"
  ]
}
